# Скопіюйте у .env (не комітити!). За замовчуванням працює локально без зовнішніх ключів API.
RETRIEVER_BACKEND=local
LLM_PROVIDER=local
LLM_MODEL=local-extractive-v1

# Для підключення OpenAI / Groq / Ollama (OpenAI-compatible API):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Ключі доступу до нашого REST API (2 ролі):
API_KEY_PUBLIC=demo-public-key
API_KEY_ADMIN=demo-admin-key
RATE_LIMIT_PER_MIN=10
